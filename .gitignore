# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── Database ───────────────────────────────────────────
# SQLite is the dev store and is recreated by seeding on first run.
# Committing it would ship one developer's test data as everyone's baseline.
*.db
*.db-wal
*.db-shm

# ── Node / Expo ────────────────────────────────────────
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# ── Native projects ────────────────────────────────────
# Generated by `expo prebuild`; regenerating is the supported workflow.
/mobile/android/
/mobile/ios/

# ── Secrets — never commit ─────────────────────────────
*.keystore
*.jks
play-service-account.json
google-services.json
.env
.env.*
!.env.example

# ── OS / editor ────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
